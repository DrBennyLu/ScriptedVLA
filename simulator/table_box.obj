# Unit box (-0.5 to 0.5) with UV for table texture
# 8 vertices
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# UV coordinates (reused per face)
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Faces: v/vt (1-based), triangles
# bottom z=-0.5
f 1/1 2/2 3/3
f 1/1 3/3 4/4
# top z=0.5
f 5/1 6/2 7/3
f 5/1 7/3 8/4
# front y=-0.5
f 1/1 2/2 6/3
f 1/1 6/3 5/4
# back y=0.5
f 4/1 3/2 7/3
f 4/1 7/3 8/4
# left x=-0.5
f 1/1 4/2 8/3
f 1/1 8/3 5/4
# right x=0.5
f 2/1 6/2 7/3
f 2/1 7/3 3/4
